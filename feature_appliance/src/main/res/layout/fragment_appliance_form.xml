<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_EDEEF5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/inputForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.inensus.core_ui.dropdown_input.DropdownInputView
                        android:id="@+id/applianceDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_margin="8dp"
                        app:dropdown_input_title="@string/appliance"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Shown only for appliances tracked as individual units. -->
                    <com.inensus.core_ui.dropdown_input.DropdownInputView
                        android:id="@+id/deviceDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_margin="8dp"
                        android:visibility="gone"
                        app:dropdown_input_title="@string/appliance_device"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/applianceDropdown" />

                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/applianceBarrier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="applianceDropdown,deviceDropdown" />

                    <com.inensus.core_ui.default_input.DefaultInputView
                        android:id="@+id/cost"
                        style="@style/DefaultInputView"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_margin="8dp"
                        app:hint="@string/appliance_cost_hint"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/applianceBarrier"
                        app:title="@string/appliance_cost" />

                    <com.inensus.core_ui.date_input.DateInputView
                        android:id="@+id/paymentDate"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_margin="8dp"
                        app:date_input_title="@string/appliance_payment_date"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cost" />

                    <com.inensus.core_ui.default_input.DefaultInputView
                        android:id="@+id/downPayment"
                        style="@style/DefaultInputView"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_margin="8dp"
                        android:layout_marginBottom="8dp"
                        app:hint="@string/payment_amount_hint"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/paymentDate"
                        app:title="@string/appliance_down_payment" />

                    <com.inensus.core_ui.dropdown_input.DropdownInputView
                        android:id="@+id/rateTypeDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_margin="8dp"
                        app:dropdown_input_title="@string/appliance_rate_type"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/downPayment" />

                    <com.inensus.core_ui.dropdown_input.DropdownInputView
                        android:id="@+id/installmentModeDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_margin="8dp"
                        app:dropdown_input_title="@string/appliance_installment_mode"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rateTypeDropdown" />

                    <com.inensus.core_ui.default_input.DefaultInputView
                        android:id="@+id/tenure"
                        style="@style/DefaultInputView"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_margin="8dp"
                        android:layout_marginBottom="8dp"
                        app:hint="@string/appliance_installment_count_hint"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/installmentModeDropdown"
                        app:title="@string/appliance_installment_count" />

                    <com.inensus.core_ui.default_input.DefaultInputView
                        android:id="@+id/installmentCost"
                        style="@style/DefaultInputView"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_margin="8dp"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        app:hint="@string/appliance_installment_cost_hint"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/installmentModeDropdown"
                        app:title="@string/appliance_installment_cost" />

                    <!-- Only one of the two installment inputs is on screen at a time, so the
                         result line follows whichever is visible rather than collapsing onto
                         the hidden one. -->
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/installmentInputsBarrier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="tenure,installmentCost" />

                    <ImageView
                        android:id="@+id/ivAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_amount"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/installmentInputsBarrier" />

                    <TextView
                        android:id="@+id/amountLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/regular"
                        android:text="@string/appliance_installment_amount"
                        android:textColor="@color/blue_1A237E"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@+id/ivAmount"
                        app:layout_constraintStart_toEndOf="@+id/ivAmount"
                        app:layout_constraintTop_toTopOf="@+id/ivAmount" />

                    <TextView
                        android:id="@+id/amountValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/bold"
                        android:text="@string/zero_amount"
                        android:textColor="@color/blue_1A237E"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@+id/ivAmount"
                        app:layout_constraintStart_toEndOf="@+id/amountLabel"
                        app:layout_constraintTop_toTopOf="@+id/ivAmount" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonContinue"
                style="@style/MaterialButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/button_continue"
                app:cornerRadius="2dp" />

        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/loadingLayout"
        layout="@layout/appliance_form_loading_view"
        android:visibility="gone" />

    <include
        android:id="@+id/errorLayout"
        layout="@layout/error_layout"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>